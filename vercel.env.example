# Alpha Market deployment environment template
# Copy these keys into the deployment provider's environment settings.
# Never commit a populated .env file or put real secrets in this file.

NODE_ENV=production
PORT=3000
DATABASE_URL=
DATABASE_POOL_LIMIT=5
JWT_SECRET=replace-with-a-long-random-server-secret
VITE_APP_ID=
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=
PUBLIC_APP_URL=https://alphacorp.name.ng

BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

VITE_APP_TITLE=Alpha Market
VITE_APP_LOGO=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

GEMINI_API_KEY=
CJ_DROPSHIPPING_API_KEY=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

NOWPAYMENTS_API_BASE_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_TEST_MODE=false

RESEND_API_KEY=
RESEND_FROM_EMAIL=Alpha Market <noreply@example.com>
RESEND_NEWSLETTER_ENABLED=false
RESEND_OTP_EMAIL_ENABLED=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
RUN_EXTERNAL_PROVIDER_CHECKS=false

# NEXT_PUBLIC_SITE_URL is not read by this Vite + Express application.
# Use PUBLIC_APP_URL for server-side absolute URLs instead.
